    <fullName>Threshold_Mode__c</fullName>
    <label>Threshold Mode</label>
    <description>Fixed uses the Raise and Escalate thresholds. Baseline uses the standard deviation model: the average and standard deviation of monthly counts over the lookback, with limits at 1, 2 and 3 standard deviations.</description>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Fixed</fullName>
                <default>true</default>
                <label>Fixed</label>
            </value>
            <value>
                <fullName>Baseline</fullName>
                <default>false</default>
                <label>Baseline</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
