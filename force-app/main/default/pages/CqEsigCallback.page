<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0" title="Finishing signature">
<p id="m" style="font: 14px -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; padding: 24px;">Finishing signature…</p>
<script>
(function () {
  var p = new URLSearchParams(window.location.search);
  var msg = { type: 'cqesig', code: p.get('code'), state: p.get('state'), error: p.get('error'), error_description: p.get('error_description') };
  if (window.opener) {
    window.opener.postMessage(msg, window.location.origin);
    setTimeout(function () { window.close(); }, 300);
  } else {
    document.getElementById('m').textContent = 'You can close this window and return to the test page.';
  }
})();
</script>
</apex:page>
