{
  "orgName": "CQ 16 with Generative AI",
  "edition": "Enterprise",
  "features": [
    "Einstein1AIPlatform",
    "StateAndCountryPicklist",
    "Communities",
    "SalesforceContentUser",
    "DevelopmentWave",
    "AnalyticsAdminPerms"
  ],
  "settings": {
    "einsteinGptSettings": {
      "enableEinsteinGptPlatform": true
    },
    "emailAdministrationSettings": {
      "enableEnhancedEmailEnabled": true
    },
    "customAddressFieldSettings": {
      "enableCustomAddressField": true
    },
    "enhancedNotesSettings": {
      "enableEnhancedNotes": true
    },
    "communitiesSettings": {
      "enableNetworksEnabled": true
    },
    "languageSettings": {
      "enableTranslationWorkbench": true
    },
    "chatterSettings": {
      "enableChatter": true
    },
    "contentSettings": {
      "enableContent": true,
      "skipContentAssetTriggersOnDeploy": true,
      "skipContentAssetTriggers": true
    },
    "securitySettings": {
      "sessionSettings": {
        "lockerServiceNext": true
      }
    },
    "flowSettings": {
      "enableFlowFieldFilterEnabled": true
    },
    "apexSettings": {
      "enableApexApprovalLockUnlock": true
    },
    "userManagementSettings": {
      "userAccessPoliciesEnabled": true
    }
  }
}
